class FoodCategoryPage extends StatelessWidget {
  final CartModel cart;
  final String category;
  final List<Map<String, dynamic>> items;
  FoodCategoryPage({
    required this.cart,
    required this.category,
    required this.items,
  });
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('$category Items')),
      body: ListView.separated(
        padding: EdgeInsets.all(12),
        itemCount: items.length,
        separatorBuilder: (_, __) => Divider(),
        itemBuilder: (_, i) {
          final it = items[i];
          final String id = it['id'] as String;
          final String name = it['name'] as String;
          final double price = (it['price'] as num).toDouble();
          final String imageUrl = it['imageUrl'] as String; // Get the image URL

          return ListTile(
            leading: CircleAvatar(
              radius: 25,
              backgroundImage: NetworkImage(
                imageUrl,
              ), // Use NetworkImage for background
              backgroundColor: Colors.grey[200], // Fallback color
            ),
            title: Text(name),
            subtitle: Text('₹ ${price.toStringAsFixed(0)}'),
            trailing: ElevatedButton(
              onPressed: () {
                cart.addItem(id, name, price);
                ScaffoldMessenger.of(
                  context,
                ).showSnackBar(SnackBar(content: Text('$name added to cart')));
              },
              child: Text('Add'),
            ),
          );
        },
      ),
    );
  }
}

