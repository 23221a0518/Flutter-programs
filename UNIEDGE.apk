  @override
  _BooksPageState createState() => _BooksPageState();
}

class _BooksPageState extends State<BooksPage> {
  final List<Map<String, dynamic>> books = [
    {
      'id': 'book_1',
      'title': 'The Flutter Journey',
      'author': 'Pavan Chennam',
      'price': 249,
    },
    {
      'id': 'book_2',
      'title': 'Dart for Beginners',
      'author': 'John Mathew',
      'price': 199,
    },
    {
      'id': 'book_3',
      'title': 'Mastering UI Design',
      'author': 'Ananya Rao',
      'price': 299,
    },
    {
      'id': 'book_4',
      'title': 'Programming Logic Simplified',
      'author': 'Rahul Dev',
      'price': 179,
    },
    {
      'id': 'book_5',
      'title': 'Data Structures with Dart',
      'author': 'Sneha Reddy',
      'price': 259,
    },
    {
      'id': 'book_6',
      'title': 'Mobile App Architecture',
      'author': 'Vikram Iyer',
      'price': 309,
    },
    {
      'id': 'book_7',
      'title': 'Effective Flutter Widgets',
      'author': 'Meera Kaur',
      'price': 199,
    },
    {
      'id': 'book_8',
      'title': 'State Management Essentials',
      'author': 'Arjun Patel',
      'price': 279,
    },
    {
      'id': 'book_9',
      'title': 'Clean Code Practices',
      'author': 'Riya Sharma',
      'price': 329,
    },
    {
      'id': 'book_10',
      'title': 'Firebase Integration Guide',
      'author': 'Sandeep Kumar',
      'price': 249,
    },
    {
      'id': 'book_11',
      'title': 'Networking in Flutter',
      'author': 'Deepika Nair',
      'price': 219,
    },
    {
      'id': 'book_12',
      'title': 'Animations & Transitions',
      'author': 'Harish Singh',
      'price': 289,
    },
  ];

  String filter = '';

  @override
  Widget build(BuildContext context) {
    final filtered = books
        .where(
          (b) => (b['title'] as String).toLowerCase().contains(
            filter.toLowerCase(),
          ),
        )
        .toList();

    return Scaffold(
      body: Padding(
        padding: EdgeInsets.all(12),
        child: Column(
          children: [
            TextField(
              decoration: InputDecoration(
                prefixIcon: Icon(Icons.search),
                hintText: 'Search books...',
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(10),
                  borderSide: BorderSide.none,
                ),
              ),
              onChanged: (v) => setState(() => filter = v),
            ),
            SizedBox(height: 12),
            Expanded(
              child: GridView.builder(
                itemCount: filtered.length,
                gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: MediaQuery.of(context).size.width > 600
                      ? 4
                      : 2,
                  mainAxisExtent: 180,
                  crossAxisSpacing: 10,
                  mainAxisSpacing: 10,
                ),
                itemBuilder: (_, i) {
                  final b = filtered[i];
                  final String id = b['id'] as String;
                  final String title = b['title'] as String;
                  final String author = b['author'] as String;
                  final double price = (b['price'] as num).toDouble();

                  // Use different placeholder image for each book
                  final String imageUrl =
                      'https://picsum.photos/200/300?image=${i + 30}';

                  return Card(
                    elevation: 4,
                    clipBehavior: Clip.antiAlias,
                    child: Padding(
                      padding: EdgeInsets.all(8),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Expanded(
                            child: ClipRRect(
                              borderRadius: BorderRadius.circular(4),
                              child: Image.network(
                                imageUrl,
                                width: double.infinity,
                                fit: BoxFit.cover,
                                errorBuilder: (context, error, stackTrace) =>
                                    Center(
                                      child: Icon(
                                        Icons.menu_book,
                                        size: 36,
                                        color: Colors.grey,
                                      ),
                                    ),
                                loadingBuilder: (context, child, progress) =>
                                    progress == null
                                    ? child
                                    : Center(
                                        child: CircularProgressIndicator(
                                          strokeWidth: 2,
                                        ),
                                      ),
                              ),
                            ),
                          ),
                          SizedBox(height: 8),
                          Text(
                            title,
                            style: TextStyle(fontWeight: FontWeight.bold),
                            overflow: TextOverflow.ellipsis,
                          ),
                          Text(
                            author,
                            style: TextStyle(
                              fontSize: 12,
                              color: Colors.grey[600],
                            ),
                            overflow: TextOverflow.ellipsis,
                          ),
                          Spacer(),
                          Row(
                            mainAxisAlignment: MainAxisAlignment.spaceBetween,
                            children: [
                              Text(
                                '₹ ${price.toStringAsFixed(0)}',
                                style: TextStyle(fontWeight: FontWeight.bold),
                              ),
                              ElevatedButton(
                                onPressed: () {
                                  widget.cart.addItem(id, title, price);
                                  ScaffoldMessenger.of(context).showSnackBar(
                                    SnackBar(
                                      content: Text('$title added to cart'),
                                    ),
                                  );
                                },
                                child: Text('Add'),
                              ),
                            ],
                          ),
                        ],
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}

