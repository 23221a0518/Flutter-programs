                'Your One Stop Destination !!',
                style: TextStyle(color: Colors.white70, fontSize: 16),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

// ---------------------------- AUTH WRAPPER ----------------------------
// Simplified AuthWrapper. It now takes AppState and manages the in-memory
// registered user directly.
class AuthWrapper extends StatefulWidget {
  final AppState appState;
  AuthWrapper({required this.appState});
  @override
  _AuthWrapperState createState() => _AuthWrapperState();
}

class _AuthWrapperState extends State<AuthWrapper> {
  User? _registeredUser;

  void _navigateToMainApp(User user) {
    widget.appState.setCurrentUser(user);
    Navigator.of(context).pushReplacement(
      MaterialPageRoute(
        builder: (_) => MainAppScreen(appState: widget.appState),
      ),
    );
  }

  void register(User u) {
    setState(() {
      _registeredUser = u;
    });
    _navigateToMainApp(u);
  }

  void login(String emailOrUsername, String password) {
    if (_registeredUser == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('No account found. Please create an account.')),
      );
      return;
    }
    if ((emailOrUsername == _registeredUser!.email ||
            emailOrUsername == _registeredUser!.username) &&
        password == _registeredUser!.password) {
      _navigateToMainApp(_registeredUser!);
    } else {
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Invalid credentials')));
    }
  }

  @override
  Widget build(BuildContext context) {
    // If user is already logged in (e.g., after logout/re-login flow), navigate them directly.
    if (widget.appState.currentUser != null) {
      // This case handles the post-logout navigation from ProfilePage if you re-use AuthWrapper
      // in the pushAndRemoveUntil, but the logic in ProfilePage already navigates correctly.
      // This is mostly a fallback/initial check.
      return MainAppScreen(appState: widget.appState);
    }

    return LoginPage(
      onLogin: login,
      onRegisterNavigate: () {
        Navigator.of(context).push(
          MaterialPageRoute(builder: (_) => RegisterPage(onRegister: register)),
        );
      },
    );
  }
}

// ---------------------------- LOGIN PAGE ----------------------------
class LoginPage extends StatefulWidget {
  final void Function(String, String) onLogin;
  final VoidCallback onRegisterNavigate;
  LoginPage({required this.onLogin, required this.onRegisterNavigate});
  @override
  _LoginPageState createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  final _form = GlobalKey<FormState>();
  String _id = '';
  String _password = '';
  bool _loading = false;

  void submit() {
    if (!_form.currentState!.validate()) return;
    _form.currentState!.save();
    widget.onLogin(_id.trim(), _password);
  }

  @override
  Widget build(BuildContext context) {
    final w = MediaQuery.of(context).size.width;
    return Scaffold(
      body: Container(
        decoration: BoxDecoration(
          gradient: LinearGradient(
            colors: [Colors.purple.shade200, Colors.deepPurple.shade400],
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
        ),
        child: SafeArea(
          child: SingleChildScrollView(
            padding: EdgeInsets.symmetric(horizontal: 18, vertical: 30),
            child: Column(
              children: [
                Align(
                  alignment: Alignment.topLeft,
                  child: Text(
                    'UniEdge',
                    style: TextStyle(
                      fontSize: 28,
                      color: Colors.white,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                SizedBox(height: 24),
                Card(
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(16),
                  ),
                  elevation: 10,
                  child: Padding(
                    padding: EdgeInsets.all(18),
                    child: Form(
                      key: _form,
                      child: Column(
                        children: [
                          Text(
                            'Welcome Back',
                            style: TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                          SizedBox(height: 6),
                          Text(
                            'Sign in to continue',
                            style: TextStyle(color: Colors.grey[700]),
                          ),
                          SizedBox(height: 16),
                          TextFormField(
                            decoration: InputDecoration(
                              labelText: 'Email or Username',
                            ),
                            validator: (v) => (v == null || v.trim().isEmpty)
                                ? 'Enter email or username'
                                : null,
                            onSaved: (v) => _id = v ?? '',
                          ),
                          SizedBox(height: 10),
                          TextFormField(
                            decoration: InputDecoration(labelText: 'Password'),
                            obscureText: true,
                            validator: (v) => (v == null || v.isEmpty)
                                ? 'Enter password'
                                : null,
                            onSaved: (v) => _password = v ?? '',
                          ),
                          SizedBox(height: 16),
                          _loading
                              ? CircularProgressIndicator()
                              : ElevatedButton(
                                  onPressed: () {
                                    setState(() {
                                      _loading = true;
                                    });
                                    // small delay to simulate auth
                                    Future.delayed(
                                      Duration(milliseconds: 300),
                                      () {
                                        setState(() {
                                          _loading = false;
                                        });
                                        submit();
                                      },
                                    );
                                  },
                                  child: SizedBox(
                                    width: w,
                                    child: Center(child: Text('Login')),
                                  ),
                                ),
                          SizedBox(height: 8),
                          TextButton(
                            onPressed: widget.onRegisterNavigate,
                            child: Text(
                              'Create Account',
                              style: TextStyle(
                                decoration: TextDecoration.underline,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

// ---------------------------- REGISTER PAGE ----------------------------
class RegisterPage extends StatefulWidget {
  final void Function(User) onRegister;
  RegisterPage({required this.onRegister});
  @override
  _RegisterPageState createState() => _RegisterPageState();
}

class _RegisterPageState extends State<RegisterPage> {
  final _form = GlobalKey<FormState>();
  String _name = '';
  String _username = '';
  String _email = '';
  String _phone = '';
  String _password = '';
  String _confirm = '';

  String? _validateEmail(String? v) {
    if (v == null || v.trim().isEmpty) return 'Enter email';
    if (!v.contains('@')) return 'Email must contain "@"';
    return null;
  }

  String? _validateUsername(String? v) {
    if (v == null || v.trim().isEmpty) return 'Enter username';
    if (!v.contains('_')) return 'Username must contain "_"';
    return null;
  }

  String? _validatePhone(String? v) {
    if (v == null || v.trim().isEmpty) return 'Enter phone';
    final digits = v.replaceAll(RegExp(r'\D'), '');
    if (digits.length != 10) return 'Phone must contain 10 digits';
    return null;
  }

  String? _validateName(String? v) {
    if (v == null || v.trim().isEmpty) return 'Enter name';
    if (v.trim().length < 5) return 'Name must contain at least 5 characters';
    return null;
  }

  String? _validatePassword(String? v) {
    if (v == null || v.isEmpty) return 'Enter password';
    bool hasLetter = v.contains(RegExp(r'[A-Za-z]'));
    bool hasDigit = v.contains(RegExp(r'\d'));

    // Using a multi-line raw string r'''...''' allows the single quote ' to be
    // included in the character set without prematurely ending the string.
    bool hasSymbol = v.contains(
      RegExp(r'''[!@#\$%\^&\*\(\)\-_=\+\[\]\{\};\:\'\",.<>\/?\\|`~]'''),
    );

    if (!hasLetter || !hasDigit || !hasSymbol)
      return 'Password must mix letters, numbers and symbols';
    if (v.length < 6) return 'Password should be at least 6 chars';
    return null;
  }

  void submit() {
    // We already validated in the button, but it's safe to keep.
    if (!_form.currentState!.validate()) return;
    _form.currentState!.save();
    final user = User(
      name: _name.trim(),
      username: _username.trim(),
      email: _email.trim(),
      phone: _phone.trim(),
      password: _password,
    );
    widget.onRegister(user);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Create Account'), centerTitle: true),
      body: SingleChildScrollView(
        padding: EdgeInsets.all(16),
        child: Card(
          elevation: 6,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
          child: Padding(
            padding: EdgeInsets.all(16),
            child: Form(
              key: _form,
              child: Column(
                children: [
                  TextFormField(
                    decoration: InputDecoration(labelText: 'Full Name'),
                    validator: _validateName,
                    onSaved: (v) => _name = v ?? '',
                  ),
                  SizedBox(height: 8),
                  TextFormField(
                    decoration: InputDecoration(
                      labelText: 'Username (must contain "_")',
                    ),
                    validator: _validateUsername,
                    onSaved: (v) => _username = v ?? '',
                  ),
                  SizedBox(height: 8),
                  TextFormField(
                    decoration: InputDecoration(labelText: 'Email'),
                    validator: _validateEmail,
                    onSaved: (v) => _email = v ?? '',
                  ),
                  SizedBox(height: 8),
                  TextFormField(
                    decoration: InputDecoration(labelText: 'Phone (10 digits)'),
                    keyboardType: TextInputType.phone,
                    validator: _validatePhone,
                    onSaved: (v) => _phone = v ?? '',
                  ),
                  SizedBox(height: 8),
                  TextFormField(
                    decoration: InputDecoration(
                      labelText: 'Password (mix letters, numbers, symbols)',
                    ),
                    obscureText: true,
                    validator: _validatePassword,
                    // --- THIS IS THE FIX ---
                    // Update _password as the user types, so the
                    // "Confirm Password" validator has the correct value.
                    onChanged: (v) {
                      _password = v;
                    },
                    onSaved: (v) => _password = v ?? '',
                  ),
                  SizedBox(height: 8),
                  TextFormField(
                    decoration: InputDecoration(labelText: 'Confirm Password'),
                    obscureText: true,
                    validator: (v) {
                      // Now, _password will have the current value
                      // from the field above, thanks to onChanged.
                      if (v == null || v.isEmpty) return 'Confirm password';
                      if (v != _password) return 'Passwords do not match';
                      return null;
                    },
                    onSaved: (v) => _confirm = v ?? '',
                  ),
                  SizedBox(height: 14),
                  ElevatedButton(
                    onPressed: () {
                      // The submit method handles validation and saving
                      // and correctly builds the User object.
                      // The password match validation is handled by the last TextFormField's validator.
                      if (_form.currentState!.validate()) {
                        submit();
                      }
                    },
                    child: SizedBox(
                      width: double.infinity,
                      child: Center(child: Text('Create Account')),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

// ---------------------------- CART MODEL ----------------------------
class CartItem {
  final String id;
  final String title;
  final double price;
  int qty;
  CartItem({
    required this.id,
    required this.title,
    required this.price,
    this.qty = 1,
  });
}

class CartModel extends ChangeNotifier {
  final Map<String, CartItem> _items = {};
  Map<String, CartItem> get items => _items;
  int get totalCount => _items.values.fold(0, (s, i) => s + i.qty);
  double get totalPrice =>
      _items.values.fold(0.0, (s, i) => s + i.price * i.qty);

  void addItem(String id, String title, double price) {
    if (_items.containsKey(id)) {
      _items[id]!.qty += 1;
    } else {
      _items[id] = CartItem(id: id, title: title, price: price);
    }
    notifyListeners();
  }

  void removeSingle(String id) {
    if (!_items.containsKey(id)) return;
    if (_items[id]!.qty > 1) {
      _items[id]!.qty -= 1;
    } else {
      _items.remove(id);
    }
    notifyListeners();
  }

  void clear() {
    _items.clear();
    notifyListeners();
  }
}

// ---------------------------- MAIN APP SCREEN ----------------------------
// Simplified to take AppState and use it for all state-dependent properties.
class MainAppScreen extends StatefulWidget {
  final AppState appState;
  MainAppScreen({required this.appState});
  @override
  _MainAppScreenState createState() => _MainAppScreenState();
}

class _MainAppScreenState extends State<MainAppScreen> {
  int _currentIndex = 0;
  final TextEditingController _searchController = TextEditingController();

  List<Widget> _pages(User user, CartModel cart, AppState appState) => [
    HomePage(cart: cart),
    FoodRootPage(cart: cart),
    BooksPage(cart: cart),
    OutfitsRootPage(cart: cart),
    TravelPage(),
    ProfilePage(user: user, appState: appState), // Pass AppState to ProfilePage
  ];

  // Custom logout logic to clean up MainAppScreen
  void _handleLogout() {
    widget.appState.setCurrentUser(null);
    // Navigate back to AuthWrapper
    Navigator.of(context).pushAndRemoveUntil(
      MaterialPageRoute(builder: (_) => AuthWrapper(appState: widget.appState)),
      (route) => false,
    );
  }

  @override
  Widget build(BuildContext context) {
    final user = widget.appState.currentUser!; // Should not be null here
    final cart = widget.appState.cart;
    final pages = _pages(user, cart, widget.appState);

    // This screen is now a consumer of AppState for its theme-dependent properties
    // and CartModel for the cart count in the AppBar.
    return Scaffold(
      appBar: PreferredSize(
        preferredSize: Size.fromHeight(90),
        child: AppBar(
          automaticallyImplyLeading: false,
          title: Row(
            children: [
              Text(
                'UniEdge',
                style: Theme.of(context).appBarTheme.titleTextStyle,
              ),
              SizedBox(width: 12),
              Expanded(
                child: Padding(
                  padding: const EdgeInsets.only(top: 10.0),
                  child: TextField(
                    controller: _searchController,
                    decoration: InputDecoration(
                      contentPadding: EdgeInsets.symmetric(
                        vertical: 8,
                        horizontal: 12,
                      ),
                      hintText: 'Search products, books, food...',
                      filled: true,
                      fillColor:
                          Theme.of(context).brightness == Brightness.light
                          ? Colors.white
                          : Colors.grey[800],
                      prefixIcon: Icon(Icons.search),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(10),
                        borderSide: BorderSide.none,
                      ),
                    ),
                    onSubmitted: (v) {
                      ScaffoldMessenger.of(
                        context,
                      ).showSnackBar(SnackBar(content: Text('Search: "$v"')));
                    },
                  ),
                ),
              ),
            ],
          ),
          actions: [
            Padding(
              padding: EdgeInsets.only(right: 12.0, top: 8),
              // Use Consumer to react to cart changes
              child: Consumer<AppState>(
                builder: (_, state, __) {
                  // Consume AppState to get cart
                  final cart = state.cart;
                  return Stack(
                    alignment: Alignment.topRight,
                    children: [
                      IconButton(
                        onPressed: () {
                          Navigator.of(context).push(
                            MaterialPageRoute(
                              builder: (_) => CartPage(cart: cart),
                            ),
                          );
                        },
                        icon: Icon(Icons.shopping_cart_outlined),
                      ),
                      if (cart.totalCount > 0)
                        Positioned(
                          right: 6,
                          top: 6,
                          child: Container(
                            padding: EdgeInsets.all(4),
                            decoration: BoxDecoration(
                              color: Colors.redAccent,
                              shape: BoxShape.circle,
                            ),
                            child: Text(
                              '${cart.totalCount}',
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 12,
                              ),
                            ),
                          ),
                        ),
                    ],
                  );
                },
              ),
            ),
          ],
          bottom: PreferredSize(
            preferredSize: Size.fromHeight(0),
            child: SizedBox(height: 8),
          ),
        ),
      ),
      body: pages[_currentIndex],
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _currentIndex,
        type: BottomNavigationBarType.fixed,
        onTap: (i) => setState(() => _currentIndex = i),
        items: [
          BottomNavigationBarItem(icon: Icon(Icons.home), label: 'Home'),
          BottomNavigationBarItem(icon: Icon(Icons.fastfood), label: 'Food'),
          BottomNavigationBarItem(icon: Icon(Icons.book), label: 'Books'),
          BottomNavigationBarItem(
            icon: Icon(Icons.checkroom),
            label: 'Outfits',
          ),
          BottomNavigationBarItem(icon: Icon(Icons.flight), label: 'Travel'),
          BottomNavigationBarItem(icon: Icon(Icons.person), label: 'Profile'),
        ],
      ),
    );
  }
}

// ---------------------------- HOME PAGE ----------------------------
class HomePage extends StatelessWidget {
  final CartModel cart;
  HomePage({required this.cart});
  final List<Map<String, dynamic>> highlights = [
    {'title': 'Campus Meals', 'icon': Icons.restaurant},
    {'title': 'Books', 'icon': Icons.book},
    {'title': 'Clothes', 'icon': Icons.checkroom},
    {'title': 'Travel', 'icon': Icons.directions_bus},
  ];

  @override
  Widget build(BuildContext context) {
    double crossAxis = (MediaQuery.of(context).size.width / 180)
        .floorToDouble();
    if (crossAxis < 2) crossAxis = 2;
    return SingleChildScrollView(
      padding: EdgeInsets.all(14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text('Welcome', style: Theme.of(context).textTheme.headlineSmall),
          SizedBox(height: 10),
          SizedBox(
            height: 110,
            child: ListView.separated(
              scrollDirection: Axis.horizontal,
              itemCount: highlights.length,
              separatorBuilder: (_, __) => SizedBox(width: 12),
              itemBuilder: (_, idx) {
                var h = highlights[idx];
                return Container(
                  width: 160,
                  decoration: BoxDecoration(
                    color: Theme.of(context).cardColor,
                    borderRadius: BorderRadius.circular(12),
                    boxShadow: [
                      BoxShadow(color: Colors.black12, blurRadius: 6),
                    ],
                  ),
                  child: Padding(
                    padding: EdgeInsets.all(12),
                    child: Row(
                      children: [
                        CircleAvatar(
                          child: Icon(h['icon'], color: Colors.white),
                          backgroundColor: Colors.deepPurple,
                        ),
                        SizedBox(width: 10),
                        Expanded(
                          child: Text(
                            h['title'] as String,
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),
                        ),
                      ],
                    ),
                  ),
                );
              },
            ),
          ),
          SizedBox(height: 16),
          Text('Top Picks', style: TextStyle(fontWeight: FontWeight.bold)),
          SizedBox(height: 10),
          // Use Consumer for ProductCard grid to automatically update cart count without local setState
          Consumer<AppState>(
            builder: (_, appState, __) {
              final cart = appState.cart;
              return GridView.builder(
                shrinkWrap: true,
                physics: NeverScrollableScrollPhysics(),
                itemCount: 6,
                gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: crossAxis.toInt(),
                  mainAxisExtent: 150,
                  crossAxisSpacing: 10,
                  mainAxisSpacing: 10,
                ),
                itemBuilder: (_, i) {
                  final id = 'home_$i';
                  final title = 'Item ${i + 1}';
                  final price = 49.0 + i * 20;
                  // Get a different placeholder image for each card
                  final imageUrl =
                      'https://picsum.photos/200/200?image=${i + 10}';

                  return ProductCard(
                    id: id,
                    title: title,
                    price: price,
                    imageUrl: imageUrl, // Pass the image URL
                    onAdd: () => cart.addItem(id, title, price),
                  );
                },
              );
            },
          ),
        ],
      ),
    );
  }
}

// ---------------------------- FOOD FLOW ----------------------------
